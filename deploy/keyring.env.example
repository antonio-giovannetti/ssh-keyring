# Copia in /etc/ssh-keyring/keyring.env e imposta i permessi:
#   install -m 600 -o root -g root keyring.env.example /etc/ssh-keyring/keyring.env
#
# Chiave master di cifratura del keyring (32 byte in base64). OBBLIGATORIA.
# Generala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Conservala anche fuori dal server: se si perde, le voci non sono recuperabili.
KEYRING_KEY=

# Ascolto solo in locale: l'accesso dall'esterno passa dal reverse proxy HTTPS.
HOST=127.0.0.1
PORT=8080

# Cookie di sessione con flag Secure (richiede HTTPS davanti al server).
COOKIE_SECURE=1
